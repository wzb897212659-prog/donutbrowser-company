+      ParseCompanyPortableOSCryptConfig(PortableConfig(encrypted_key));
+  ASSERT_TRUE(config);
+  EXPECT_EQ(kEnvironmentId, config->environment_id);
+  EXPECT_EQ(kKeyId, config->key_id);
+  EXPECT_EQ(encrypted_key, config->encrypted_key_base64);
+}
+
+TEST(CompanyPersonaConfigTest, RejectsNonCanonicalPortableOSCryptEnvelope) {
+  const std::string encrypted_key =
+      base::Base64Encode(std::vector<uint8_t>(64, 0x42));
+  std::string uppercase_environment = PortableConfig(encrypted_key);
+  base::ReplaceSubstringsAfterOffset(&uppercase_environment, 0, kEnvironmentId,
+                                     "11111111-1111-4111-8111-AAAAAAAAAAAA");
+  EXPECT_FALSE(ParseCompanyPortableOSCryptConfig(uppercase_environment));
+
+  std::string wrong_wrapping = PortableConfig(encrypted_key);
+  base::ReplaceSubstringsAfterOffset(&wrong_wrapping, 0,
+                                     "windows-dpapi-current-user", "plaintext");
+  EXPECT_FALSE(ParseCompanyPortableOSCryptConfig(wrong_wrapping));
+  EXPECT_FALSE(
+      ParseCompanyPortableOSCryptConfig(PortableConfig(encrypted_key) + "\n"));
+
+  std::string invalid_version = PortableConfig(encrypted_key);
+  base::ReplaceSubstringsAfterOffset(&invalid_version, 0, kEnvironmentId,
+                                     "11111111-1111-0111-8111-111111111111");
+  EXPECT_FALSE(ParseCompanyPortableOSCryptConfig(invalid_version));
+  std::string invalid_variant = PortableConfig(encrypted_key);
+  base::ReplaceSubstringsAfterOffset(&invalid_variant, 0, kKeyId,
+                                     "22222222-2222-4222-7222-222222222222");
+  EXPECT_FALSE(ParseCompanyPortableOSCryptConfig(invalid_variant));
+}
+
+TEST(CompanyPersonaConfigTest, LoadsAndUnwrapsPortableOSCryptKey) {
+  base::ScopedTempDir profile;
+  ASSERT_TRUE(profile.CreateUniqueTempDir());
+  std::vector<uint8_t> expected(kCompanyPortableOSCryptKeyBytes);
+  for (size_t index = 0; index < expected.size(); ++index) {
+    expected[index] = static_cast<uint8_t>(index + 1);
+  }
+  const std::string encrypted_key = ProtectPortableKey(expected);
+  ASSERT_FALSE(encrypted_key.empty());
+  ASSERT_TRUE(base::WriteFile(
+      profile.GetPath().Append(kCompanyPortableOSCryptConfigBasename),
+      PortableConfig(encrypted_key)));
+  std::optional<CompanyPortableOSCryptKey> key =
+      LoadCompanyPortableOSCryptKey(profile.GetPath());
+  ASSERT_TRUE(key);
+  EXPECT_EQ(kEnvironmentId, key->environment_id());
+  EXPECT_EQ(kKeyId, key->key_id());
+  EXPECT_TRUE(std::ranges::equal(expected, key->key_bytes()));
+}
+
+TEST(CompanyPersonaConfigTest, LoadsBoundManagedStartupCohort) {
+  base::ScopedTempDir profile;
+  ASSERT_TRUE(profile.CreateUniqueTempDir());
+  std::vector<uint8_t> expected(kCompanyPortableOSCryptKeyBytes, 0x37);
+  const std::string encrypted_key = ProtectPortableKey(expected);
+  ASSERT_FALSE(encrypted_key.empty());
+  ASSERT_TRUE(base::WriteFile(
+      profile.GetPath().Append(kCompanyPersonaConfigBasename), kValidConfig));
+  ASSERT_TRUE(base::WriteFile(
+      profile.GetPath().Append(kCompanyPortableOSCryptConfigBasename),
+      PortableConfig(encrypted_key)));
+
+  std::optional<CompanyManagedStartupConfig> startup =
+      LoadCompanyManagedStartupConfig(
+          profile.GetPath(),
+          profile.GetPath().Append(kCompanyPersonaConfigBasename));
+  ASSERT_TRUE(startup);
+  EXPECT_EQ(kEnvironmentId, startup->persona.environment_id);
+  EXPECT_EQ(kKeyId, startup->persona.portable_key_id);
+  EXPECT_EQ(kEnvironmentId, startup->portable_os_crypt_key.environment_id());
+  EXPECT_EQ(kKeyId, startup->portable_os_crypt_key.key_id());
+  EXPECT_TRUE(
+      std::ranges::equal(expected, startup->portable_os_crypt_key.key_bytes()));
+}
+
+TEST(CompanyPersonaConfigTest,
+     LoadsBoundManagedStartupCohortBeforeFeatureListRegistration) {
+  base::ScopedTempDir profile;
+  ASSERT_TRUE(profile.CreateUniqueTempDir());
+  std::vector<uint8_t> expected(kCompanyPortableOSCryptKeyBytes, 0x3a);
+  const std::string encrypted_key = ProtectPortableKey(expected);
+  ASSERT_FALSE(encrypted_key.empty());
+  ASSERT_TRUE(base::WriteFile(
+      profile.GetPath().Append(kCompanyPersonaConfigBasename), kValidConfig));
+  ASSERT_TRUE(base::WriteFile(
+      profile.GetPath().Append(kCompanyPortableOSCryptConfigBasename),
+      PortableConfig(encrypted_key)));
+
+  std::optional<CompanyManagedStartupConfig> startup = [&] {
+    base::test::ScopedFeatureList feature_list;
+    feature_list.InitWithNullFeatureAndFieldTrialLists();
+    base::FeatureList::FailOnFeatureAccessWithoutFeatureList();
+    return LoadCompanyManagedStartupConfig(
+        profile.GetPath(),
+        profile.GetPath().Append(kCompanyPersonaConfigBasename));
+  }();
+
+  ASSERT_TRUE(startup);
+  EXPECT_EQ(kEnvironmentId, startup->persona.environment_id);
+  EXPECT_EQ(kKeyId, startup->persona.portable_key_id);
+  EXPECT_TRUE(
+      std::ranges::equal(expected, startup->portable_os_crypt_key.key_bytes()));
+}
+
+TEST(CompanyPersonaConfigTest, RejectsMismatchedManagedStartupCohort) {
+  base::ScopedTempDir profile;
+  ASSERT_TRUE(profile.CreateUniqueTempDir());
+  const std::vector<uint8_t> key_bytes(kCompanyPortableOSCryptKeyBytes, 0x38);
+  const std::string encrypted_key = ProtectPortableKey(key_bytes);
+  ASSERT_FALSE(encrypted_key.empty());
+  const std::string mismatched_persona =
+      ReplaceValidConfig(kKeyId, "33333333-3333-4333-8333-333333333333");
+  ASSERT_TRUE(
+      base::WriteFile(profile.GetPath().Append(kCompanyPersonaConfigBasename),
+                      mismatched_persona));
+  ASSERT_TRUE(base::WriteFile(
+      profile.GetPath().Append(kCompanyPortableOSCryptConfigBasename),
+      PortableConfig(encrypted_key)));
+
+  EXPECT_FALSE(LoadCompanyManagedStartupConfig(
+      profile.GetPath(),
+      profile.GetPath().Append(kCompanyPersonaConfigBasename)));
+}
+
+TEST(CompanyPersonaConfigTest, RejectsHardLinkedPortableConfigInCohort) {
+  base::ScopedTempDir profile;
+  ASSERT_TRUE(profile.CreateUniqueTempDir());
+  const std::vector<uint8_t> key_bytes(kCompanyPortableOSCryptKeyBytes, 0x39);
+  const std::string encrypted_key = ProtectPortableKey(key_bytes);
+  ASSERT_FALSE(encrypted_key.empty());
+  ASSERT_TRUE(base::WriteFile(
+      profile.GetPath().Append(kCompanyPersonaConfigBasename), kValidConfig));
+  const base::FilePath source =
+      profile.GetPath().AppendASCII("portable-source.json");
+  ASSERT_TRUE(base::WriteFile(source, PortableConfig(encrypted_key)));
+  ASSERT_TRUE(base::CreateWinHardLink(
+      profile.GetPath().Append(kCompanyPortableOSCryptConfigBasename), source));
+
+  EXPECT_FALSE(LoadCompanyManagedStartupConfig(
+      profile.GetPath(),
+      profile.GetPath().Append(kCompanyPersonaConfigBasename)));
+}
+
+TEST(CompanyPersonaConfigTest, PortableOSCryptKeyIsInstalledAndTakenOnce) {
+  ResetCompanyPortableOSCryptKeyForTesting();
+  std::vector<uint8_t> bytes(kCompanyPortableOSCryptKeyBytes, 0x23);
+  ASSERT_TRUE(InstallCompanyPortableOSCryptKeyForBrowserProcess(
+      CompanyPortableOSCryptKey(kEnvironmentId, kKeyId, std::move(bytes))));
+  EXPECT_FALSE(InstallCompanyPortableOSCryptKeyForBrowserProcess(
+      CompanyPortableOSCryptKey(
+          kEnvironmentId, kKeyId,
+          std::vector<uint8_t>(kCompanyPortableOSCryptKeyBytes, 0x24))));
+  std::optional<CompanyPortableOSCryptKey> taken =
+      TakeCompanyPortableOSCryptKeyForBrowserProcess();
+  ASSERT_TRUE(taken);
+  EXPECT_EQ(kEnvironmentId, taken->environment_id());
+  EXPECT_EQ(kKeyId, taken->key_id());
+  EXPECT_FALSE(TakeCompanyPortableOSCryptKeyForBrowserProcess());
+  ResetCompanyPortableOSCryptKeyForTesting();
+}
+
+}  // namespace
+}  // namespace chrome
