@@ -0,0 +1,68 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/public/common/company_persona/company_persona.h"
+
+#include "base/test/icu_test_util.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace blink {
+namespace {
+
+class CompanyPersonaTest : public testing::Test {
+ protected:
+  void SetUp() override { CompanyPersona::ResetForTesting(); }
+  void TearDown() override { CompanyPersona::ResetForTesting(); }
+};
+
+TEST_F(CompanyPersonaTest, InstallsAllowedValuesAtomically) {
+  EXPECT_TRUE(CompanyPersona::Install(12, 16));
+  EXPECT_TRUE(CompanyPersona::IsLocked());
+  EXPECT_EQ(12u, CompanyPersona::HardwareConcurrency());
+  EXPECT_EQ(16u, CompanyPersona::DeviceMemoryGiB());
+}
+
+TEST_F(CompanyPersonaTest, SameInstallIsIdempotentButReplacementFails) {
+  ASSERT_TRUE(CompanyPersona::Install(8, 8));
+  EXPECT_TRUE(CompanyPersona::Install(8, 8));
+  EXPECT_FALSE(CompanyPersona::Install(16, 16));
+  EXPECT_EQ(8u, CompanyPersona::HardwareConcurrency());
+  EXPECT_EQ(8u, CompanyPersona::DeviceMemoryGiB());
+}
+
+TEST_F(CompanyPersonaTest, RejectsOutOfRangeHardwareConcurrency) {
+  EXPECT_FALSE(CompanyPersona::Install(0, 8));
+  EXPECT_FALSE(CompanyPersona::Install(257, 8));
+  EXPECT_FALSE(CompanyPersona::IsLocked());
+}
+
+TEST_F(CompanyPersonaTest, RejectsUncatalogedDeviceMemory) {
+  EXPECT_FALSE(CompanyPersona::Install(8, 1));
+  EXPECT_FALSE(CompanyPersona::Install(8, 3));
+  EXPECT_FALSE(CompanyPersona::Install(8, 64));
+  EXPECT_FALSE(CompanyPersona::IsLocked());
+}
+
+TEST_F(CompanyPersonaTest, ValidatesCanonicalIcuStateWithoutChangingIt) {
+  {
+    base::test::ScopedRestoreDefaultTimezone timezone(
+        CompanyPersona::kTimeZone);
+    EXPECT_TRUE(CompanyPersona::IsExpectedTimeZone());
+  }
+  {
+    base::test::ScopedRestoreDefaultTimezone timezone("America/Los_Angeles");
+    EXPECT_FALSE(CompanyPersona::IsExpectedTimeZone());
+  }
+  {
+    base::test::ScopedRestoreICUDefaultLocale locale(CompanyPersona::kLocale);
+    EXPECT_TRUE(CompanyPersona::IsExpectedLocale());
+  }
+  {
+    base::test::ScopedRestoreICUDefaultLocale locale("en-US");
+    EXPECT_FALSE(CompanyPersona::IsExpectedLocale());
+  }
+}
+
+}  // namespace
+}  // namespace blink
