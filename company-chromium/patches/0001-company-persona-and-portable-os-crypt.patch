+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_PUBLIC_COMMON_COMPANY_PERSONA_COMPANY_PERSONA_H_
+#define THIRD_PARTY_BLINK_PUBLIC_COMMON_COMPANY_PERSONA_COMPANY_PERSONA_H_
+
+#include <stdint.h>
+
+#include "third_party/blink/public/common/common_export.h"
+
+namespace blink {
+
+// Process-local, immutable hardware values for a managed browser persona.
+// The browser installs the values from its profile-owned configuration before
+// normal startup. Renderer processes receive the same values through internal
+// command-line switches and install them before Blink initialization.
+class BLINK_COMMON_EXPORT CompanyPersona final {
+ public:
+  inline static constexpr char kLockedSwitch[] =
+      "company-persona-internal-locked";
+  inline static constexpr char kHardwareConcurrencySwitch[] =
+      "company-persona-internal-hardware-concurrency";
+  inline static constexpr char kDeviceMemoryGiBSwitch[] =
+      "company-persona-internal-device-memory-gib";
+  inline static constexpr char kTimeZone[] = "Asia/Shanghai";
+  inline static constexpr char kLocale[] = "zh-CN";
+  inline static constexpr char kSecondaryLanguage[] = "zh";
+  inline static constexpr char kAcceptLanguages[] = "zh-CN,zh";
+  inline static constexpr char kOverrideError[] =
+      "COMPANY_PERSONA_LOCKED: browser persona is managed and cannot be "
+      "overridden";
+
+  static constexpr uint32_t kMinHardwareConcurrency = 1;
+  static constexpr uint32_t kMaxHardwareConcurrency = 256;
+
+  // Installs a persona once per process. Reinstalling the same values is
+  // idempotent; attempting to replace them or install invalid values fails.
+  static bool Install(uint32_t hardware_concurrency,
+                      uint32_t device_memory_gib);
+
+  static bool IsLocked();
+  static uint32_t HardwareConcurrency();
+  static uint32_t DeviceMemoryGiB();
+  static bool IsValidDeviceMemoryGiB(uint32_t device_memory_gib);
+
+  // These checks must only be called after ICU initialization. They validate
+  // that the immutable persona matches the process-wide ICU state without
+  // changing the host locale or time zone.
+  static bool IsExpectedTimeZone();
+  static bool IsExpectedLocale();
+
+  // Only for unit tests. Production startup never unlocks a persona.
+  static void ResetForTesting();
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_PUBLIC_COMMON_COMPANY_PERSONA_COMPANY_PERSONA_H_
