+TEST_F(InspectorEmulationAgentTest,
+       AllowsOnlyCanonicalPlaywrightMediaResetWithoutMutation) {
+  test::TaskEnvironment task_environment;
+  frame_test_helpers::WebViewHelper helper;
+  WebViewImpl* web_view = helper.Initialize();
+  WebLocalFrameImpl* web_frame = web_view->MainFrameImpl();
+  LocalFrame* frame = web_frame->GetFrame();
+  Document* document = frame->GetDocument();
+
+  DummyFrontendChannel channel;
+  protocol::UberDispatcher dispatcher(&channel);
+  auto reattach_state = mojom::blink::DevToolsSessionState::New();
+  InspectorSessionState session_state(std::move(reattach_state));
+  auto* agent = MakeGarbageCollected<InspectorEmulationAgent>(
+      web_frame, *web_view->Scheduler()->GetVirtualTimeController());
+  agent->Init(frame->GetProbeSink(), &dispatcher, &session_state);
+
+  auto canonical_reset = [] {
+    auto features = std::make_unique<
+        protocol::Array<protocol::Emulation::MediaFeature>>();
+    features->push_back(protocol::Emulation::MediaFeature::create()
+                            .setName("prefers-color-scheme")
+                            .setValue("light")
+                            .build());
+    features->push_back(protocol::Emulation::MediaFeature::create()
+                            .setName("prefers-reduced-motion")
+                            .setValue("no-preference")
+                            .build());
+    features->push_back(protocol::Emulation::MediaFeature::create()
+                            .setName("forced-colors")
+                            .setValue("none")
+                            .build());
+    features->push_back(protocol::Emulation::MediaFeature::create()
+                            .setName("prefers-contrast")
+                            .setValue("no-preference")
+                            .build());
+    return features;
+  };
+  auto media_matches = [document](const char* query) {
+    return document->GetMediaQueryMatcher().MatchMedia(query)->matches();
+  };
+  const String native_media_type =
+      web_view->GetPage()->GetSettings().GetMediaTypeOverride();
+  const bool native_screen = media_matches("screen");
+  const bool native_print = media_matches("print");
+  const bool native_dark =
+      media_matches("(prefers-color-scheme: dark)");
+  ASSERT_EQ(nullptr, web_view->GetPage()->GetMediaFeatureOverrides());
+  ASSERT_TRUE(CompanyPersona::Install(12, 16));
+
+  EXPECT_TRUE(
+      agent->setEmulatedMedia(String(""), canonical_reset()).IsSuccess());
+  EXPECT_EQ(native_media_type,
+            web_view->GetPage()->GetSettings().GetMediaTypeOverride());
+  EXPECT_EQ(nullptr, web_view->GetPage()->GetMediaFeatureOverrides());
+  EXPECT_EQ(native_screen, media_matches("screen"));
+  EXPECT_EQ(native_print, media_matches("print"));
+  EXPECT_EQ(native_dark, media_matches("(prefers-color-scheme: dark)"));
+
+  auto expect_locked = [](const protocol::Response& response) {
+    EXPECT_EQ(crdtp::DispatchCode::SERVER_ERROR, response.Code());
+    EXPECT_EQ(kExpectedCompanyPersonaLockedError, response.Message());
+  };
+
+  expect_locked(agent->setEmulatedMedia(std::nullopt, canonical_reset()));
+  expect_locked(agent->setEmulatedMedia(String(""), nullptr));
+
+  auto empty_values = canonical_reset();
+  for (auto& feature : *empty_values) {
+    feature = protocol::Emulation::MediaFeature::create()
+                  .setName(feature->getName())
+                  .setValue("")
+                  .build();
+  }
+  expect_locked(
+      agent->setEmulatedMedia(String(""), std::move(empty_values)));
+
+  auto reordered = canonical_reset();
+  std::swap((*reordered)[0], (*reordered)[1]);
+  expect_locked(agent->setEmulatedMedia(String(""), std::move(reordered)));
+
+  auto changed_value = canonical_reset();
+  (*changed_value)[0] = protocol::Emulation::MediaFeature::create()
+                           .setName("prefers-color-scheme")
+                           .setValue("dark")
+                           .build();
+  expect_locked(
+      agent->setEmulatedMedia(String(""), std::move(changed_value)));
+
+  auto unknown_feature = canonical_reset();
+  (*unknown_feature)[3] = protocol::Emulation::MediaFeature::create()
+                              .setName("pointer")
+                              .setValue("no-preference")
+                              .build();
+  expect_locked(
+      agent->setEmulatedMedia(String(""), std::move(unknown_feature)));
+
+  auto extra_feature = canonical_reset();
+  extra_feature->push_back(protocol::Emulation::MediaFeature::create()
+                               .setName("prefers-reduced-transparency")
+                               .setValue("no-preference")
+                               .build());
+  expect_locked(agent->setEmulatedMedia(String(""), std::move(extra_feature)));
+
+  auto active_media = canonical_reset();
