diff --git a/content/renderer/company_persona_init_unittest.cc b/content/renderer/company_persona_init_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..106b182db074f3afaff6f42c76ca3034f38ca938
--- /dev/null
+++ b/content/renderer/company_persona_init_unittest.cc
@@ -0,0 +1,124 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/renderer/company_persona_init.h"
+
+#include <array>
+
+#include "base/command_line.h"
+#include "base/test/icu_test_util.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/blink/public/common/company_persona/company_persona.h"
+
+namespace content {
+namespace {
+
+class CompanyPersonaInitTest : public testing::Test {
+ protected:
+  void SetUp() override { blink::CompanyPersona::ResetForTesting(); }
+  void TearDown() override { blink::CompanyPersona::ResetForTesting(); }
+};
+
+void AddInternalSwitches(base::CommandLine* command_line, unsigned mask) {
+  if (mask & 1) {
+    command_line->AppendSwitchASCII(blink::CompanyPersona::kLockedSwitch, "1");
+  }
+  if (mask & 2) {
+    command_line->AppendSwitchASCII(
+        blink::CompanyPersona::kHardwareConcurrencySwitch, "12");
+  }
+  if (mask & 4) {
+    command_line->AppendSwitchASCII(
+        blink::CompanyPersona::kDeviceMemoryGiBSwitch, "16");
+  }
+}
+
+TEST_F(CompanyPersonaInitTest, AllowsEntirelyAbsentSwitchSet) {
+  base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+  EXPECT_TRUE(InstallCompanyPersonaFromInternalSwitches(command_line));
+  EXPECT_FALSE(blink::CompanyPersona::IsLocked());
+}
+
+TEST_F(CompanyPersonaInitTest, RejectsEveryPartialSwitchSet) {
+  for (unsigned mask = 1; mask < 7; ++mask) {
+    SCOPED_TRACE(mask);
+    blink::CompanyPersona::ResetForTesting();
+    base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+    AddInternalSwitches(&command_line, mask);
+    EXPECT_FALSE(InstallCompanyPersonaFromInternalSwitches(command_line));
+    EXPECT_FALSE(blink::CompanyPersona::IsLocked());
+  }
+}
+
+TEST_F(CompanyPersonaInitTest, InstallsCompleteCanonicalSwitchSet) {
+  base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+  AddInternalSwitches(&command_line, 7);
+  ASSERT_TRUE(InstallCompanyPersonaFromInternalSwitches(command_line));
+  EXPECT_EQ(12u, blink::CompanyPersona::HardwareConcurrency());
+  EXPECT_EQ(16u, blink::CompanyPersona::DeviceMemoryGiB());
+}
+
+TEST_F(CompanyPersonaInitTest, RejectsMalformedOrInvalidValues) {
+  const std::array<std::array<const char*, 3>, 3> values = {{
+      {"0", "12", "16"},
+      {"1", "012", "16"},
+      {"1", "12", "3"},
+  }};
+  for (const auto& value : values) {
+    SCOPED_TRACE(value[0]);
+    SCOPED_TRACE(value[1]);
+    SCOPED_TRACE(value[2]);
+    blink::CompanyPersona::ResetForTesting();
+    base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+    command_line.AppendSwitchASCII(blink::CompanyPersona::kLockedSwitch,
+                                   value[0]);
+    command_line.AppendSwitchASCII(
+        blink::CompanyPersona::kHardwareConcurrencySwitch, value[1]);
+    command_line.AppendSwitchASCII(
+        blink::CompanyPersona::kDeviceMemoryGiBSwitch, value[2]);
+    EXPECT_FALSE(InstallCompanyPersonaFromInternalSwitches(command_line));
+    EXPECT_FALSE(blink::CompanyPersona::IsLocked());
+  }
+}
+
+TEST_F(CompanyPersonaInitTest, RejectsConflictWithInstalledPersona) {
+  ASSERT_TRUE(blink::CompanyPersona::Install(8, 8));
+  base::CommandLine command_line(base::CommandLine::NO_PROGRAM);
+  AddInternalSwitches(&command_line, 7);
+  EXPECT_FALSE(InstallCompanyPersonaFromInternalSwitches(command_line));
+  EXPECT_EQ(8u, blink::CompanyPersona::HardwareConcurrency());
+  EXPECT_EQ(8u, blink::CompanyPersona::DeviceMemoryGiB());
+}
+
+TEST_F(CompanyPersonaInitTest, ValidatesManagedIcuState) {
+  ASSERT_TRUE(blink::CompanyPersona::Install(12, 16));
+  {
+    base::test::ScopedRestoreDefaultTimezone timezone(
+        blink::CompanyPersona::kTimeZone);
+    base::test::ScopedRestoreICUDefaultLocale locale(
+        blink::CompanyPersona::kLocale);
+    EXPECT_TRUE(ValidateInstalledCompanyPersonaIcuState());
+  }
+  {
+    base::test::ScopedRestoreDefaultTimezone timezone("Europe/London");
+    base::test::ScopedRestoreICUDefaultLocale locale(
+        blink::CompanyPersona::kLocale);
+    EXPECT_FALSE(ValidateInstalledCompanyPersonaIcuState());
+  }
+  {
+    base::test::ScopedRestoreDefaultTimezone timezone(
+        blink::CompanyPersona::kTimeZone);
+    base::test::ScopedRestoreICUDefaultLocale locale("en-US");
+    EXPECT_FALSE(ValidateInstalledCompanyPersonaIcuState());
+  }
+}
+
+TEST_F(CompanyPersonaInitTest, AllowsUnlockedIcuState) {
+  base::test::ScopedRestoreDefaultTimezone timezone("Europe/London");
+  base::test::ScopedRestoreICUDefaultLocale locale("en-US");
+  EXPECT_TRUE(ValidateInstalledCompanyPersonaIcuState());
+}
+
+}  // namespace
+}  // namespace content
