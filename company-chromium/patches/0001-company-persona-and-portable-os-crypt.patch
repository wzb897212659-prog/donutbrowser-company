+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/renderer/company_persona_init.h"
+
+#include <stdint.h>
+
+#include <string>
+
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
+#include "third_party/blink/public/common/company_persona/company_persona.h"
+
+namespace content {
+namespace {
+
+bool ParseCanonicalUintSwitch(const base::CommandLine& command_line,
+                              const char* switch_name,
+                              uint32_t* value) {
+  const std::string encoded = command_line.GetSwitchValueASCII(switch_name);
+  return !encoded.empty() && base::StringToUint(encoded, value) &&
+         encoded == base::NumberToString(*value);
+}
+
+}  // namespace
+
+bool InstallCompanyPersonaFromInternalSwitches(
+    const base::CommandLine& command_line) {
+  const bool has_locked =
+      command_line.HasSwitch(blink::CompanyPersona::kLockedSwitch);
+  const bool has_hardware =
+      command_line.HasSwitch(blink::CompanyPersona::kHardwareConcurrencySwitch);
+  const bool has_memory =
+      command_line.HasSwitch(blink::CompanyPersona::kDeviceMemoryGiBSwitch);
+
+  if (!has_locked && !has_hardware && !has_memory) {
+    return true;
+  }
+  if (!has_locked || !has_hardware || !has_memory ||
+      command_line.GetSwitchValueASCII(blink::CompanyPersona::kLockedSwitch) !=
+          "1") {
+    return false;
+  }
+
+  uint32_t hardware_concurrency = 0;
+  uint32_t device_memory_gib = 0;
+  return ParseCanonicalUintSwitch(
+             command_line, blink::CompanyPersona::kHardwareConcurrencySwitch,
+             &hardware_concurrency) &&
+         ParseCanonicalUintSwitch(command_line,
+                                  blink::CompanyPersona::kDeviceMemoryGiBSwitch,
+                                  &device_memory_gib) &&
+         blink::CompanyPersona::Install(hardware_concurrency,
+                                        device_memory_gib);
+}
+
+bool ValidateInstalledCompanyPersonaIcuState() {
+  return !blink::CompanyPersona::IsLocked() ||
+         (blink::CompanyPersona::IsExpectedTimeZone() &&
+          blink::CompanyPersona::IsExpectedLocale());
+}
+
+}  // namespace content
