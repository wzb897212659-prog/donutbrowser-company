+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/os_crypt/company_portable_key_provider_win.h"
+
+#include <utility>
+#include <vector>
+
+#include "base/check.h"
+#include "components/os_crypt/async/common/algorithm.mojom.h"
+#include "components/os_crypt/async/common/encryptor.h"
+#include "crypto/secure_util.h"
+
+namespace os_crypt_async {
+
+CompanyPortableKeyProviderWin::CompanyPortableKeyProviderWin(
+    chrome::CompanyPortableOSCryptKey key)
+    : key_(std::move(key)) {
+  CHECK_EQ(key_.key_bytes().size(), chrome::kCompanyPortableOSCryptKeyBytes);
+}
+
+CompanyPortableKeyProviderWin::~CompanyPortableKeyProviderWin() = default;
+
+void CompanyPortableKeyProviderWin::GetKey(KeyCallback callback) {
+  CHECK(!key_was_consumed_);
+  key_was_consumed_ = true;
+  std::vector<uint8_t> key_bytes = std::move(key_).TakeKeyBytes();
+  CHECK_EQ(key_bytes.size(), chrome::kCompanyPortableOSCryptKeyBytes);
+  Encryptor::Key key(key_bytes, mojom::Algorithm::kAES256GCM);
+  crypto::SecureZeroBuffer(key_bytes);
+  std::move(callback).Run(kCompanyPortableDataPrefix, std::move(key));
+}
+
+bool CompanyPortableKeyProviderWin::UseForEncryption() {
+  return true;
+}
+
+}  // namespace os_crypt_async
