+// Playwright 1.62.1 sends this exact native-default tuple while initializing
+// each Chromium frame with default media options. It is the only
+// managed-persona media request allowed to fall through to Blink, where the
+// renderer independently verifies that its inspector media state is already
+// native and performs no mutation.
+bool IsCanonicalPlaywrightMediaReset(
+    const std::optional<std::string>& media,
+    const std::unique_ptr<
+        protocol::Array<protocol::Emulation::MediaFeature>>& features) {
+  if (!media.has_value() || !media->empty() || !features ||
+      features->size() != 4u) {
+    return false;
+  }
+
+  auto matches = [](const auto& feature, const char* expected_name,
+                    const char* expected_value) {
+    return feature->GetName() == expected_name &&
+           feature->GetValue() == expected_value;
+  };
+  return matches((*features)[0], "prefers-color-scheme", "light") &&
+         matches((*features)[1], "prefers-reduced-motion", "no-preference") &&
+         matches((*features)[2], "forced-colors", "none") &&
+         matches((*features)[3], "prefers-contrast", "no-preference");
+}
