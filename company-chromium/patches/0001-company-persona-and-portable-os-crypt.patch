+
+bool GetAttributeTag(HANDLE handle, FILE_ATTRIBUTE_TAG_INFO* info) {
+  return ::GetFileInformationByHandleEx(handle, FileAttributeTagInfo, info,
+                                        sizeof(*info));
+}
+
+bool IsPlainDirectory(HANDLE handle) {
+  FILE_ATTRIBUTE_TAG_INFO info = {};
+  return GetAttributeTag(handle, &info) &&
+         (info.FileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0 &&
+         (info.FileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) == 0;
+}
+
+bool IsDriveAbsolutePath(const base::FilePath& path) {
+  const std::wstring& value = path.value();
+  return value.size() >= 3 &&
+         ((value[0] >= L'a' && value[0] <= L'z') ||
+          (value[0] >= L'A' && value[0] <= L'Z')) &&
+         value[1] == L':' && base::FilePath::IsSeparator(value[2]);
+}
+
+std::optional<base::FilePath> NormalizeLexicalDrivePath(
+    const base::FilePath& path) {
+  if (!IsDriveAbsolutePath(path) || path.ReferencesParent()) {
+    return std::nullopt;
+  }
+  const base::FilePath absolute =
+      base::MakeAbsoluteFilePath(path).NormalizePathSeparators();
+  if (!IsDriveAbsolutePath(absolute) || absolute.ReferencesParent()) {
+    return std::nullopt;
+  }
+  return absolute.StripTrailingSeparators();
+}
+
+std::optional<base::FilePath> GetFinalDrivePath(HANDLE handle) {
+  constexpr DWORD kFlags = FILE_NAME_NORMALIZED | VOLUME_NAME_DOS;
+  const DWORD required =
+      ::GetFinalPathNameByHandleW(handle, nullptr, 0, kFlags);
+  if (required == 0 || required > 32767) {
+    return std::nullopt;
+  }
+
+  std::wstring value(required, L'\0');
+  const DWORD written =
+      ::GetFinalPathNameByHandleW(handle, value.data(), required, kFlags);
+  if (written == 0 || written >= required) {
+    return std::nullopt;
+  }
+  value.resize(written);
+
+  constexpr std::wstring_view kExtendedDrivePrefix = LR"(\\?\)";
+  if (!value.starts_with(kExtendedDrivePrefix)) {
+    return std::nullopt;
+  }
+  value.erase(0, kExtendedDrivePrefix.size());
+  return NormalizeLexicalDrivePath(base::FilePath(value));
+}
+
+bool SameDrivePath(const base::FilePath& left, const base::FilePath& right) {
+  return base::FilePath::CompareEqualIgnoreCase(left.value(), right.value());
+}
+
+bool IsCompanyUuid(std::string_view value) {
+  return base::Uuid::ParseLowercase(value).is_valid() && value.size() == 36 &&
+         value[14] >= '1' && value[14] <= '8' &&
+         (value[19] == '8' || value[19] == '9' || value[19] == 'a' ||
+          value[19] == 'b');
+}
+
+bool IsSingleLinkRegularFile(HANDLE handle, int64_t expected_size) {
+  FILE_ATTRIBUTE_TAG_INFO attributes = {};
+  BY_HANDLE_FILE_INFORMATION identity = {};
+  LARGE_INTEGER size = {};
+  return ::GetFileType(handle) == FILE_TYPE_DISK &&
+         GetAttributeTag(handle, &attributes) &&
+         (attributes.FileAttributes &
+          (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT)) == 0 &&
+         ::GetFileInformationByHandle(handle, &identity) &&
+         identity.nNumberOfLinks == 1 && ::GetFileSizeEx(handle, &size) &&
+         size.QuadPart == expected_size;
+}
+
+base::win::ScopedHandle OpenConfigForRead(const base::FilePath& config_path) {
+  return base::win::ScopedHandle(
+      ::CreateFileW(config_path.value().c_str(), GENERIC_READ, FILE_SHARE_READ,
+                    nullptr, OPEN_EXISTING,
+                    FILE_ATTRIBUTE_NORMAL | FILE_FLAG_OPEN_REPARSE_POINT |
+                        FILE_FLAG_SEQUENTIAL_SCAN,
+                    nullptr));
+}
+
+std::optional<std::string> ReadConfigFromOpenHandle(
+    HANDLE file,
+    const base::FilePath& config_path,
+    size_t max_bytes) {
+  if (file == INVALID_HANDLE_VALUE || file == nullptr) {
+    return std::nullopt;
+  }
+
+  LARGE_INTEGER size = {};
+  const std::optional<base::FilePath> final_config_path =
+      GetFinalDrivePath(file);
+  if (!::GetFileSizeEx(file, &size) || size.QuadPart < 1 ||
+      size.QuadPart > static_cast<LONGLONG>(max_bytes) ||
+      !IsSingleLinkRegularFile(file, size.QuadPart) || !final_config_path ||
+      !SameDrivePath(*final_config_path, config_path)) {
+    return std::nullopt;
+  }
+
+  std::string contents(static_cast<size_t>(size.QuadPart), '\0');
+  DWORD bytes_read = 0;
+  if (!::ReadFile(file, contents.data(), static_cast<DWORD>(contents.size()),
+                  &bytes_read, nullptr) ||
+      bytes_read != static_cast<DWORD>(contents.size()) ||
+      !IsSingleLinkRegularFile(file, size.QuadPart) ||
+      GetFinalDrivePath(file) != final_config_path) {
+    return std::nullopt;
+  }
+  return contents;
+}
+
+base::win::ScopedHandle OpenValidatedProfileDirectory(
+    const base::FilePath& normalized_user_data_dir) {
+  base::win::ScopedHandle profile_directory(::CreateFileW(
+      normalized_user_data_dir.value().c_str(), FILE_READ_ATTRIBUTES,
+      FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING,
+      FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr));
+  const std::optional<base::FilePath> final_profile_path =
+      profile_directory.is_valid() ? GetFinalDrivePath(profile_directory.get())
+                                   : std::nullopt;
+  if (!profile_directory.is_valid() ||
+      !IsPlainDirectory(profile_directory.get()) || !final_profile_path ||
+      !SameDrivePath(*final_profile_path, normalized_user_data_dir)) {
+    return base::win::ScopedHandle();
+  }
+  return profile_directory;
+}
+
+std::optional<std::string> ReadConfigFromOneHandle(
+    const base::FilePath& config_path,
+    size_t max_bytes) {
+  base::win::ScopedHandle file = OpenConfigForRead(config_path);
+  if (!file.is_valid()) {
+    return std::nullopt;
+  }
+  return ReadConfigFromOpenHandle(file.get(), config_path, max_bytes);
+}
+
+std::optional<std::string> ReadProfileOwnedConfig(
+    const base::FilePath& user_data_dir,
+    const base::FilePath::CharType* basename,
+    size_t max_bytes) {
+  const std::optional<base::FilePath> normalized_user_data_dir =
+      NormalizeLexicalDrivePath(user_data_dir);
+  if (!normalized_user_data_dir) {
+    return std::nullopt;
+  }
+  const base::FilePath expected_config =
+      normalized_user_data_dir->Append(basename);
+
+  // Keep the profile directory open without delete sharing while the child
+  // file is opened and read. This prevents replacing the directory in the
+  // middle of validation.
+  base::win::ScopedHandle profile_directory =
+      OpenValidatedProfileDirectory(*normalized_user_data_dir);
+  if (!profile_directory.is_valid()) {
+    return std::nullopt;
+  }
+  std::optional<std::string> contents =
+      ReadConfigFromOneHandle(expected_config, max_bytes);
+  if (!contents || !IsPlainDirectory(profile_directory.get()) ||
+      GetFinalDrivePath(profile_directory.get()) != normalized_user_data_dir) {
+    return std::nullopt;
+  }
+  return contents;
+}
+
+std::string BuildPortableOSCryptEntropy(
+    const CompanyPortableOSCryptConfig& config) {
+  std::string entropy(kCompanyPortableOSCryptEntropyDomain);
+  entropy.push_back('\0');
+  entropy.append(config.environment_id);
+  entropy.push_back('\0');
+  entropy.append(config.key_id);
+  return entropy;
+}
+
+std::optional<std::vector<uint8_t>> UnprotectPortableOSCryptKey(
+    const CompanyPortableOSCryptConfig& config) {
+  std::optional<std::vector<uint8_t>> ciphertext =
+      base::Base64Decode(config.encrypted_key_base64);
+  if (!ciphertext || ciphertext->empty() ||
+      base::Base64EncodeEarlyStartup(*ciphertext) !=
+          config.encrypted_key_base64) {
+    return std::nullopt;
+  }
+  std::string entropy_bytes = BuildPortableOSCryptEntropy(config);
+  DATA_BLOB input = {
+      .cbData = static_cast<DWORD>(ciphertext->size()),
+      .pbData = ciphertext->data(),
+  };
+  DATA_BLOB entropy = {
+      .cbData = static_cast<DWORD>(entropy_bytes.size()),
+      .pbData = reinterpret_cast<BYTE*>(entropy_bytes.data()),
+  };
+  DATA_BLOB output = {};
+  const BOOL unprotected =
+      ::CryptUnprotectData(&input, nullptr, &entropy, nullptr, nullptr,
+                           CRYPTPROTECT_UI_FORBIDDEN, &output);
+  crypto::SecureZeroBuffer(*ciphertext);
+  auto output_owner = base::win::TakeLocalAlloc(output.pbData);
+  if (!unprotected || output_owner.get() == nullptr) {
+    if (output_owner.get() != nullptr && output.cbData != 0) {
+      ::SecureZeroMemory(output_owner.get(), output.cbData);
+    }
+    return std::nullopt;
+  }
+  std::vector<uint8_t> plaintext(
+      output_owner.get(), UNSAFE_TODO(output_owner.get() + output.cbData));
+  if (output.cbData != 0) {
+    ::SecureZeroMemory(output_owner.get(), output.cbData);
+  }
+  if (plaintext.size() != kCompanyPortableOSCryptKeyBytes) {
+    crypto::SecureZeroBuffer(plaintext);
+    return std::nullopt;
+  }
+  return plaintext;
+}
+
+struct CompanyPortableOSCryptKeyState {
+  base::Lock lock;
+  std::optional<CompanyPortableOSCryptKey> key GUARDED_BY(lock);
+};
+
+CompanyPortableOSCryptKeyState& GetCompanyPortableOSCryptKeyState() {
+  static base::NoDestructor<CompanyPortableOSCryptKeyState> state;
+  return *state;
+}
+
+}  // namespace
+
+CompanyPortableOSCryptKey::CompanyPortableOSCryptKey(
+    std::string environment_id,
+    std::string key_id,
+    std::vector<uint8_t> key_bytes)
+    : environment_id_(std::move(environment_id)),
+      key_id_(std::move(key_id)),
+      key_bytes_(std::move(key_bytes)) {}
+
+CompanyPortableOSCryptKey::CompanyPortableOSCryptKey(
+    CompanyPortableOSCryptKey&& other) noexcept
+    : environment_id_(std::move(other.environment_id_)),
+      key_id_(std::move(other.key_id_)) {
+  key_bytes_.swap(other.key_bytes_);
+}
+
+CompanyPortableOSCryptKey& CompanyPortableOSCryptKey::operator=(
+    CompanyPortableOSCryptKey&& other) noexcept {
+  if (this != &other) {
+    ClearKeyBytes();
+    environment_id_ = std::move(other.environment_id_);
+    key_id_ = std::move(other.key_id_);
+    key_bytes_.swap(other.key_bytes_);
+  }
+  return *this;
+}
+
+CompanyPortableOSCryptKey::~CompanyPortableOSCryptKey() {
+  ClearKeyBytes();
+}
+
+std::vector<uint8_t> CompanyPortableOSCryptKey::TakeKeyBytes() && {
+  std::vector<uint8_t> output;
+  output.swap(key_bytes_);
+  return output;
+}
+
+void CompanyPortableOSCryptKey::ClearKeyBytes() {
+  crypto::SecureZeroBuffer(key_bytes_);
+  key_bytes_.clear();
+}
