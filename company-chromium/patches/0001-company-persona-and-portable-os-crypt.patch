+CompanyManagedStartupConfig::CompanyManagedStartupConfig(
+    CompanyPersonaConfig persona,
+    CompanyPortableOSCryptKey portable_os_crypt_key)
+    : persona(std::move(persona)),
+      portable_os_crypt_key(std::move(portable_os_crypt_key)) {}
+
+CompanyManagedStartupConfig::CompanyManagedStartupConfig(
+    CompanyManagedStartupConfig&&) noexcept = default;
+
+CompanyManagedStartupConfig::~CompanyManagedStartupConfig() = default;
+
+std::optional<CompanyPersonaConfig> ParseCompanyPersonaConfig(
+    std::string_view contents) {
+  if (contents.empty() || contents.size() > kCompanyPersonaConfigMaxBytes ||
+      contents.find('\0') != std::string_view::npos ||
+      !base::IsStringUTF8(contents) ||
+      (contents.size() >= 3 &&
+       static_cast<unsigned char>(contents[0]) == 0xef &&
+       static_cast<unsigned char>(contents[1]) == 0xbb &&
+       static_cast<unsigned char>(contents[2]) == 0xbf)) {
+    return std::nullopt;
+  }
+
+  std::optional<base::DictValue> value =
+      base::JSONReader::ReadDict(contents, base::JSON_PARSE_RFC,
+                                 /*max_depth=*/3);
+  if (!value || value->size() != 8) {
+    return std::nullopt;
+  }
+
+  const std::optional<int> schema_version = value->FindInt("schemaVersion");
+  const std::string* environment_id = value->FindString("environmentId");
+  const std::string* portable_key_id = value->FindString("portableKeyId");
+  const std::optional<int> hardware_concurrency =
+      value->FindInt("hardwareConcurrency");
+  const std::optional<int> device_memory_gib =
+      value->FindInt("deviceMemoryGiB");
+  const std::string* timezone = value->FindString("timezone");
+  const std::string* locale = value->FindString("locale");
+  const base::ListValue* languages = value->FindList("languages");
+  if (schema_version != 3 || !environment_id ||
+      !IsCompanyUuid(*environment_id) || !portable_key_id ||
+      !IsCompanyUuid(*portable_key_id) || !hardware_concurrency ||
+      !device_memory_gib || !timezone ||
+      *timezone != blink::CompanyPersona::kTimeZone || !locale ||
+      *locale != blink::CompanyPersona::kLocale || !languages ||
+      languages->size() != 2 || !(*languages)[0].is_string() ||
+      (*languages)[0].GetString() != blink::CompanyPersona::kLocale ||
+      !(*languages)[1].is_string() ||
+      (*languages)[1].GetString() !=
+          blink::CompanyPersona::kSecondaryLanguage ||
+      *hardware_concurrency <
+          static_cast<int>(blink::CompanyPersona::kMinHardwareConcurrency) ||
+      *hardware_concurrency >
+          static_cast<int>(blink::CompanyPersona::kMaxHardwareConcurrency) ||
+      *device_memory_gib <= 0 ||
+      !blink::CompanyPersona::IsValidDeviceMemoryGiB(
+          static_cast<uint32_t>(*device_memory_gib))) {
+    return std::nullopt;
+  }
+
+  const std::string canonical = base::StringPrintf(
+      "{\"schemaVersion\":3,\"environmentId\":\"%s\","
+      "\"portableKeyId\":\"%s\",\"hardwareConcurrency\":%d,"
+      "\"deviceMemoryGiB\":%d,\"timezone\":\"Asia/Shanghai\","
+      "\"locale\":\"zh-CN\",\"languages\":[\"zh-CN\",\"zh\"]}\n",
+      environment_id->c_str(), portable_key_id->c_str(), *hardware_concurrency,
+      *device_memory_gib);
+  if (contents != canonical) {
+    return std::nullopt;
+  }
+
+  return CompanyPersonaConfig{
+      .environment_id = *environment_id,
+      .portable_key_id = *portable_key_id,
+      .hardware_concurrency = static_cast<uint32_t>(*hardware_concurrency),
+      .device_memory_gib = static_cast<uint32_t>(*device_memory_gib),
+      .timezone = *timezone,
+      .locale = *locale,
+      .languages = {(*languages)[0].GetString(), (*languages)[1].GetString()}};
+}
+
+std::optional<CompanyPortableOSCryptConfig> ParseCompanyPortableOSCryptConfig(
+    std::string_view contents) {
+  if (contents.empty() ||
+      contents.size() > kCompanyPortableOSCryptConfigMaxBytes ||
+      contents.find('\0') != std::string_view::npos ||
+      !base::IsStringUTF8(contents) ||
+      (contents.size() >= 3 &&
+       static_cast<unsigned char>(contents[0]) == 0xef &&
+       static_cast<unsigned char>(contents[1]) == 0xbb &&
+       static_cast<unsigned char>(contents[2]) == 0xbf)) {
+    return std::nullopt;
+  }
+
+  std::optional<base::DictValue> value =
+      base::JSONReader::ReadDict(contents, base::JSON_PARSE_RFC,
+                                 /*max_depth=*/2);
+  if (!value || value->size() != 6) {
+    return std::nullopt;
+  }
+  const std::optional<int> schema_version = value->FindInt("schemaVersion");
+  const std::string* environment_id = value->FindString("environmentId");
+  const std::string* key_id = value->FindString("keyId");
+  const std::string* algorithm = value->FindString("algorithm");
+  const std::string* wrapping = value->FindString("wrapping");
+  const std::string* encrypted_key = value->FindString("encryptedKeyBase64");
+  if (schema_version != 1 || !environment_id || !key_id || !algorithm ||
+      *algorithm != "AES-256-GCM" || !wrapping ||
+      *wrapping != "windows-dpapi-current-user" || !encrypted_key ||
+      !IsCompanyUuid(*environment_id) || !IsCompanyUuid(*key_id)) {
+    return std::nullopt;
+  }
+  std::optional<std::vector<uint8_t>> decoded =
+      base::Base64Decode(*encrypted_key);
+  if (!decoded || decoded->size() < 40 || decoded->size() > 4096 ||
+      base::Base64EncodeEarlyStartup(*decoded) != *encrypted_key) {
+    return std::nullopt;
+  }
+
+  const std::string canonical = base::StringPrintf(
+      "{\"schemaVersion\":1,\"environmentId\":\"%s\","
+      "\"keyId\":\"%s\",\"algorithm\":\"AES-256-GCM\","
+      "\"wrapping\":\"windows-dpapi-current-user\","
+      "\"encryptedKeyBase64\":\"%s\"}\n",
+      environment_id->c_str(), key_id->c_str(), encrypted_key->c_str());
+  if (contents != canonical) {
+    return std::nullopt;
+  }
+  return CompanyPortableOSCryptConfig{
+      .environment_id = *environment_id,
+      .key_id = *key_id,
+      .encrypted_key_base64 = *encrypted_key,
+  };
+}
+
+std::optional<CompanyPersonaConfig> LoadCompanyPersonaConfig(
+    const base::FilePath& user_data_dir,
+    const base::FilePath& specified_config_path) {
+  if (!IsExpectedCompanyPersonaConfigPath(user_data_dir,
+                                          specified_config_path)) {
+    return std::nullopt;
+  }
+  std::optional<std::string> contents =
+      ReadProfileOwnedConfig(user_data_dir, kCompanyPersonaConfigBasename,
+                             kCompanyPersonaConfigMaxBytes);
+  if (!contents) {
+    return std::nullopt;
+  }
+  return ParseCompanyPersonaConfig(*contents);
+}
+
+std::optional<CompanyPortableOSCryptKey> LoadCompanyPortableOSCryptKey(
+    const base::FilePath& user_data_dir) {
+  std::optional<std::string> contents = ReadProfileOwnedConfig(
+      user_data_dir, kCompanyPortableOSCryptConfigBasename,
+      kCompanyPortableOSCryptConfigMaxBytes);
+  if (!contents) {
+    return std::nullopt;
+  }
+  std::optional<CompanyPortableOSCryptConfig> config =
+      ParseCompanyPortableOSCryptConfig(*contents);
+  if (!config) {
+    return std::nullopt;
+  }
+  std::optional<std::vector<uint8_t>> key =
+      UnprotectPortableOSCryptKey(*config);
+  if (!key) {
+    return std::nullopt;
+  }
+  return CompanyPortableOSCryptKey(config->environment_id, config->key_id,
+                                   std::move(*key));
+}
+
+std::optional<CompanyManagedStartupConfig> LoadCompanyManagedStartupConfig(
+    const base::FilePath& user_data_dir,
+    const base::FilePath& specified_persona_config_path) {
+  if (!IsExpectedCompanyPersonaConfigPath(user_data_dir,
+                                          specified_persona_config_path)) {
+    return std::nullopt;
+  }
+  const std::optional<base::FilePath> normalized_user_data_dir =
+      NormalizeLexicalDrivePath(user_data_dir);
+  if (!normalized_user_data_dir) {
+    return std::nullopt;
+  }
+
+  const base::FilePath persona_path =
+      normalized_user_data_dir->Append(kCompanyPersonaConfigBasename);
+  const base::FilePath portable_path =
+      normalized_user_data_dir->Append(kCompanyPortableOSCryptConfigBasename);
+  base::win::ScopedHandle profile_directory =
+      OpenValidatedProfileDirectory(*normalized_user_data_dir);
+  if (!profile_directory.is_valid()) {
+    return std::nullopt;
+  }
+
+  // Keep both files open at once. Each handle denies write/delete sharing, so
+  // neither half of the identity cohort can be replaced after the other half
+  // has been selected.
+  base::win::ScopedHandle persona_file = OpenConfigForRead(persona_path);
+  base::win::ScopedHandle portable_file = OpenConfigForRead(portable_path);
+  if (!persona_file.is_valid() || !portable_file.is_valid()) {
+    return std::nullopt;
+  }
+  std::optional<std::string> persona_contents = ReadConfigFromOpenHandle(
+      persona_file.get(), persona_path, kCompanyPersonaConfigMaxBytes);
+  std::optional<std::string> portable_contents =
+      ReadConfigFromOpenHandle(portable_file.get(), portable_path,
+                               kCompanyPortableOSCryptConfigMaxBytes);
+  if (!persona_contents || !portable_contents) {
+    return std::nullopt;
+  }
+
+  std::optional<CompanyPersonaConfig> persona =
+      ParseCompanyPersonaConfig(*persona_contents);
+  std::optional<CompanyPortableOSCryptConfig> portable =
+      ParseCompanyPortableOSCryptConfig(*portable_contents);
+  if (!persona || !portable ||
+      persona->environment_id != portable->environment_id ||
+      persona->portable_key_id != portable->key_id) {
+    return std::nullopt;
+  }
+  std::optional<std::vector<uint8_t>> key =
+      UnprotectPortableOSCryptKey(*portable);
+  if (!key) {
+    return std::nullopt;
+  }
+
+  const bool cohort_still_bound =
+      IsPlainDirectory(profile_directory.get()) &&
+      GetFinalDrivePath(profile_directory.get()) == normalized_user_data_dir &&
+      GetFinalDrivePath(persona_file.get()) == persona_path &&
+      GetFinalDrivePath(portable_file.get()) == portable_path;
+  if (!cohort_still_bound) {
+    crypto::SecureZeroBuffer(*key);
+    return std::nullopt;
+  }
+  return CompanyManagedStartupConfig(
+      std::move(*persona),
+      CompanyPortableOSCryptKey(portable->environment_id, portable->key_id,
+                                std::move(*key)));
+}
+
+bool InstallCompanyPortableOSCryptKeyForBrowserProcess(
+    CompanyPortableOSCryptKey key) {
+  if (key.key_bytes().size() != kCompanyPortableOSCryptKeyBytes) {
+    return false;
+  }
+  CompanyPortableOSCryptKeyState& state = GetCompanyPortableOSCryptKeyState();
+  base::AutoLock lock(state.lock);
+  if (state.key.has_value()) {
+    return false;
+  }
+  state.key.emplace(std::move(key));
+  return true;
+}
+
+std::optional<CompanyPortableOSCryptKey>
+TakeCompanyPortableOSCryptKeyForBrowserProcess() {
+  CompanyPortableOSCryptKeyState& state = GetCompanyPortableOSCryptKeyState();
+  base::AutoLock lock(state.lock);
+  if (!state.key.has_value()) {
+    return std::nullopt;
+  }
+  std::optional<CompanyPortableOSCryptKey> key(std::move(state.key));
+  state.key.reset();
+  return key;
+}
+
+void ResetCompanyPortableOSCryptKeyForTesting() {
+  CompanyPortableOSCryptKeyState& state = GetCompanyPortableOSCryptKeyState();
+  base::AutoLock lock(state.lock);
+  state.key.reset();
+}
+
+bool IsExpectedCompanyPersonaConfigPath(
+    const base::FilePath& user_data_dir,
+    const base::FilePath& specified_config_path) {
+  const std::optional<base::FilePath> normalized_user_data_dir =
+      NormalizeLexicalDrivePath(user_data_dir);
+  const std::optional<base::FilePath> normalized_specified_config =
+      NormalizeLexicalDrivePath(specified_config_path);
+  return normalized_user_data_dir && normalized_specified_config &&
+         SameDrivePath(
+             normalized_user_data_dir->Append(kCompanyPersonaConfigBasename),
+             *normalized_specified_config);
+}
