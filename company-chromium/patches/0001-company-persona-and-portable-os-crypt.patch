+  EXPECT_EQ(nullptr, web_view->GetPage()->GetMediaFeatureOverrides());
+  EXPECT_EQ(native_screen, media_matches("screen"));
+  EXPECT_EQ(native_print, media_matches("print"));
+  EXPECT_EQ(native_dark, media_matches("(prefers-color-scheme: dark)"));
+
+  agent->Dispose();
+  helper.Reset();
+}
