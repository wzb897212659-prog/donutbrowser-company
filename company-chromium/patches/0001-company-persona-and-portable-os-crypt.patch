+#include "components/os_crypt/async/browser/os_crypt_async.h"
+#include "components/os_crypt/async/common/encryptor.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace os_crypt_async {
+namespace {
+
+constexpr char kEnvironmentId[] = "11111111-1111-4111-8111-111111111111";
+constexpr char kKeyId[] = "22222222-2222-4222-8222-222222222222";
+
+TEST(CompanyPortableKeyProviderWinTest, EncryptsAndDecryptsWithCompanyTag) {
+  std::vector<uint8_t> raw_key(chrome::kCompanyPortableOSCryptKeyBytes);
+  for (size_t index = 0; index < raw_key.size(); ++index) {
+    raw_key[index] = static_cast<uint8_t>(index + 1);
+  }
+  std::vector<std::pair<size_t, std::unique_ptr<KeyProvider>>> providers;
+  providers.emplace_back(
+      20u, std::make_unique<CompanyPortableKeyProviderWin>(
+               chrome::CompanyPortableOSCryptKey(kEnvironmentId, kKeyId,
+                                                 std::move(raw_key))));
+  OSCryptAsync factory(std::move(providers));
+  base::test::TestFuture<scoped_refptr<Encryptor>> future;
+  factory.GetInstance(future.GetCallback());
+  scoped_refptr<Encryptor> encryptor = future.Take();
+  ASSERT_TRUE(encryptor);
+  ASSERT_TRUE(encryptor->IsEncryptionAvailable());
+
+  const std::optional<std::vector<uint8_t>> encrypted =
+      encryptor->EncryptString("portable-cookie-value");
+  ASSERT_TRUE(encrypted);
+  constexpr size_t kPrefixBytes = std::size(kCompanyPortableDataPrefix) - 1;
+  ASSERT_GE(encrypted->size(), kPrefixBytes);
+  EXPECT_TRUE(
+      std::ranges::equal(base::span_from_cstring(kCompanyPortableDataPrefix),
+                         base::span(*encrypted).first<kPrefixBytes>()));
+  const std::optional<std::string> decrypted =
+      encryptor->DecryptData(*encrypted);
+  ASSERT_TRUE(decrypted);
+  EXPECT_EQ("portable-cookie-value", *decrypted);
+}
+
+TEST(CompanyPortableKeyProviderWinTest, IsAlwaysTheEncryptionProvider) {
+  std::vector<uint8_t> raw_key(chrome::kCompanyPortableOSCryptKeyBytes, 0x42);
+  CompanyPortableKeyProviderWin provider(chrome::CompanyPortableOSCryptKey(
+      kEnvironmentId, kKeyId, std::move(raw_key)));
+  EXPECT_TRUE(provider.UseForEncryption());
+}
+
+}  // namespace
+}  // namespace os_crypt_async
