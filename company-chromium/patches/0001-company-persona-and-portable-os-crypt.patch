+
+// Installs the browser-supplied persona in this renderer. An entirely absent
+// set of switches is allowed for non-Chrome embedders, but any partial,
+// malformed, invalid, or conflicting set is rejected.
+bool InstallCompanyPersonaFromInternalSwitches(
+    const base::CommandLine& command_line);
+
+// Validates the fixed locale and time zone after ICU initialization. An
+// unlocked non-Chrome renderer is allowed; a managed renderer fails closed.
+bool ValidateInstalledCompanyPersonaIcuState();
