+
+  bool operator==(const CompanyPersonaConfig&) const = default;
+};
+
+struct CompanyPortableOSCryptConfig {
+  std::string environment_id;
+  std::string key_id;
+  std::string encrypted_key_base64;
+
+  bool operator==(const CompanyPortableOSCryptConfig&) const = default;
+};
+
+// Move-only holder that securely clears plaintext key bytes on destruction.
+class CompanyPortableOSCryptKey {
+ public:
+  CompanyPortableOSCryptKey(std::string environment_id,
+                            std::string key_id,
+                            std::vector<uint8_t> key_bytes);
+  CompanyPortableOSCryptKey(CompanyPortableOSCryptKey&& other) noexcept;
+  CompanyPortableOSCryptKey& operator=(
+      CompanyPortableOSCryptKey&& other) noexcept;
+  CompanyPortableOSCryptKey(const CompanyPortableOSCryptKey&) = delete;
+  CompanyPortableOSCryptKey& operator=(const CompanyPortableOSCryptKey&) =
+      delete;
+  ~CompanyPortableOSCryptKey();
+
+  const std::string& environment_id() const { return environment_id_; }
+  const std::string& key_id() const { return key_id_; }
+  base::span<const uint8_t> key_bytes() const { return key_bytes_; }
+  std::vector<uint8_t> TakeKeyBytes() &&;
+
+ private:
+  void ClearKeyBytes();
+
+  std::string environment_id_;
+  std::string key_id_;
+  std::vector<uint8_t> key_bytes_;
+};
+
+struct CompanyManagedStartupConfig {
+  CompanyPersonaConfig persona;
+  CompanyPortableOSCryptKey portable_os_crypt_key;
+
+  CompanyManagedStartupConfig(CompanyPersonaConfig persona,
+                              CompanyPortableOSCryptKey portable_os_crypt_key);
+  CompanyManagedStartupConfig(CompanyManagedStartupConfig&&) noexcept;
+  CompanyManagedStartupConfig& operator=(CompanyManagedStartupConfig&&) =
+      delete;
+  CompanyManagedStartupConfig(const CompanyManagedStartupConfig&) = delete;
+  CompanyManagedStartupConfig& operator=(const CompanyManagedStartupConfig&) =
+      delete;
+  ~CompanyManagedStartupConfig();
+};
