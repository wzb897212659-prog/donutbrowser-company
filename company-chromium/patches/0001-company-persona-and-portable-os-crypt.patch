+// Parses only the canonical schema emitted by the environment lifecycle. The
+// canonical form also rejects duplicate keys, alternate number encodings,
+// comments, a BOM, trailing data, and unknown fields.
+std::optional<CompanyPersonaConfig> ParseCompanyPersonaConfig(
+    std::string_view contents);
+
+// Parses the canonical public envelope. The DPAPI ciphertext is not decrypted
+// by this function.
+std::optional<CompanyPortableOSCryptConfig> ParseCompanyPortableOSCryptConfig(
+    std::string_view contents);
+
+bool IsExpectedCompanyPersonaConfigPath(
+    const base::FilePath& user_data_dir,
+    const base::FilePath& specified_config_path);
+
+// Reads the config directly beneath `user_data_dir` from one exclusive handle.
+// On Windows, profile/config reparse points and config hard links are rejected.
+std::optional<CompanyPersonaConfig> LoadCompanyPersonaConfig(
+    const base::FilePath& user_data_dir,
+    const base::FilePath& specified_config_path);
+
+// Loads the profile-owned envelope and unwraps its 32-byte environment key
+// with Windows DPAPI CurrentUser. The file path is always derived from the
+// already-validated user-data-dir and is never supplied on the command line.
+std::optional<CompanyPortableOSCryptKey> LoadCompanyPortableOSCryptKey(
+    const base::FilePath& user_data_dir);
+
+// Opens the profile directory and both profile-owned configuration files as
+// one startup cohort. The two files must bind the same environment and key.
+// All three handles remain open until both files have been read, parsed, and
+// revalidated, preventing a directory or file replacement from mixing two
+// independently valid environments during startup.
+std::optional<CompanyManagedStartupConfig> LoadCompanyManagedStartupConfig(
+    const base::FilePath& user_data_dir,
+    const base::FilePath& specified_persona_config_path);
+
+// Transfers the one validated key from BasicStartupComplete to the browser's
+// OSCrypt provider without exposing it through argv, prefs, logs, or IPC.
+bool InstallCompanyPortableOSCryptKeyForBrowserProcess(
+    CompanyPortableOSCryptKey key);
