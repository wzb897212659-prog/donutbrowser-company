+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/public/common/company_persona/company_persona.h"
+
+#include <atomic>
+#include <memory>
+
+#include "base/i18n/rtl.h"
+#include "third_party/icu/source/i18n/unicode/timezone.h"
+
+namespace blink {
+namespace {
+
+// Both values are published with one release operation so readers can never
+// observe a mixed persona. Zero is reserved for the unlocked state.
+std::atomic<uint64_t> g_encoded_persona{0};
+
+constexpr uint64_t Encode(uint32_t hardware_concurrency,
+                          uint32_t device_memory_gib) {
+  return (static_cast<uint64_t>(device_memory_gib) << 32) |
+         hardware_concurrency;
+}
+
+bool GetCanonicalSystemTimeZoneId(const icu::UnicodeString& id,
+                                  icu::UnicodeString* canonical_id) {
+  UErrorCode status = U_ZERO_ERROR;
+  UBool is_system_id = false;
+  icu::TimeZone::getCanonicalID(id, *canonical_id, is_system_id, status);
+  return U_SUCCESS(status) && is_system_id;
+}
+
+}  // namespace
+
+// static
+bool CompanyPersona::Install(uint32_t hardware_concurrency,
+                             uint32_t device_memory_gib) {
+  if (hardware_concurrency < kMinHardwareConcurrency ||
+      hardware_concurrency > kMaxHardwareConcurrency ||
+      !IsValidDeviceMemoryGiB(device_memory_gib)) {
+    return false;
+  }
+
+  const uint64_t encoded = Encode(hardware_concurrency, device_memory_gib);
+  uint64_t expected = 0;
+  if (g_encoded_persona.compare_exchange_strong(expected, encoded,
+                                                std::memory_order_release,
+                                                std::memory_order_acquire)) {
+    return true;
+  }
+  return expected == encoded;
+}
+
+// static
+bool CompanyPersona::IsLocked() {
+  return g_encoded_persona.load(std::memory_order_acquire) != 0;
+}
+
+// static
+uint32_t CompanyPersona::HardwareConcurrency() {
+  return static_cast<uint32_t>(
+      g_encoded_persona.load(std::memory_order_acquire));
+}
+
+// static
+uint32_t CompanyPersona::DeviceMemoryGiB() {
+  return static_cast<uint32_t>(
+      g_encoded_persona.load(std::memory_order_acquire) >> 32);
+}
+
+// static
+bool CompanyPersona::IsValidDeviceMemoryGiB(uint32_t device_memory_gib) {
+  switch (device_memory_gib) {
+    case 2:
+    case 4:
+    case 8:
+    case 16:
+    case 32:
+      return true;
+    default:
+      return false;
+  }
+}
+
+// static
+bool CompanyPersona::IsExpectedTimeZone() {
+  std::unique_ptr<icu::TimeZone> timezone(icu::TimeZone::createDefault());
+  if (!timezone) {
+    return false;
+  }
+
+  icu::UnicodeString actual_id;
+  timezone->getID(actual_id);
+  icu::UnicodeString expected_id(kTimeZone, -1, US_INV);
+  icu::UnicodeString canonical_actual;
+  icu::UnicodeString canonical_expected;
+  return GetCanonicalSystemTimeZoneId(actual_id, &canonical_actual) &&
+         GetCanonicalSystemTimeZoneId(expected_id, &canonical_expected) &&
+         canonical_actual == canonical_expected;
+}
+
+// static
+bool CompanyPersona::IsExpectedLocale() {
+  return base::i18n::GetConfiguredLocale() == kLocale;
+}
+
+// static
+void CompanyPersona::ResetForTesting() {
+  g_encoded_persona.store(0, std::memory_order_release);
+}
+
+}  // namespace blink
