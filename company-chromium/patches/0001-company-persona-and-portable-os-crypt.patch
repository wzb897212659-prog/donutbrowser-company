+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_OS_CRYPT_COMPANY_PORTABLE_KEY_PROVIDER_WIN_H_
+#define CHROME_BROWSER_OS_CRYPT_COMPANY_PORTABLE_KEY_PROVIDER_WIN_H_
+
+#include "chrome/app/company_persona_config.h"
+#include "components/os_crypt/async/browser/key_provider.h"
+
+namespace os_crypt_async {
+
+// A company-specific tag that cannot overlap Chromium's v10/v20 providers.
+inline constexpr char kCompanyPortableDataPrefix[] = "C01!";
+
+// Provides the per-environment key already validated and DPAPI-unwrapped by
+// the managed browser startup path. The provider never reads argv or prefs.
+class CompanyPortableKeyProviderWin : public KeyProvider {
+ public:
+  explicit CompanyPortableKeyProviderWin(chrome::CompanyPortableOSCryptKey key);
+  ~CompanyPortableKeyProviderWin() override;
+
+  CompanyPortableKeyProviderWin(const CompanyPortableKeyProviderWin&) = delete;
+  CompanyPortableKeyProviderWin& operator=(
+      const CompanyPortableKeyProviderWin&) = delete;
+
+  void GetKey(KeyCallback callback) override;
+  bool UseForEncryption() override;
+
+ private:
+  chrome::CompanyPortableOSCryptKey key_;
+  bool key_was_consumed_ = false;
+};
+
+}  // namespace os_crypt_async
+
+#endif  // CHROME_BROWSER_OS_CRYPT_COMPANY_PORTABLE_KEY_PROVIDER_WIN_H_
