+TEST_F(InspectorEmulationAgentTest,
+       RejectsManagedPersonaOverridesAndMakesApplyRestoreNoOp) {
+  test::TaskEnvironment task_environment;
+  frame_test_helpers::WebViewHelper helper;
+  WebViewImpl* web_view = helper.Initialize();
+  WebLocalFrameImpl* web_frame = web_view->MainFrameImpl();
+  LocalFrame* frame = web_frame->GetFrame();
+
+  DummyFrontendChannel channel;
+  protocol::UberDispatcher dispatcher(&channel);
+  auto reattach_state = mojom::blink::DevToolsSessionState::New();
+  InspectorSessionState session_state(std::move(reattach_state));
+  auto* agent = MakeGarbageCollected<InspectorEmulationAgent>(
+      web_frame, *web_view->Scheduler()->GetVirtualTimeController());
+  agent->Init(frame->GetProbeSink(), &dispatcher, &session_state);
+
+  // Seed state before locking to exercise defense-in-depth for persisted
+  // inspector state. Production installs the persona before an agent exists.
+  ASSERT_TRUE(agent->setHardwareConcurrencyOverride(24).IsSuccess());
+  ASSERT_TRUE(agent
+                  ->setUserAgentOverride("Spoofed/1.0", String("en-US"),
+                                         String("FakePlatform"), nullptr)
+                  .IsSuccess());
+  ASSERT_TRUE(CompanyPersona::Install(12, 16));
+
+  auto expect_locked = [](const protocol::Response& response) {
+    EXPECT_EQ(crdtp::DispatchCode::SERVER_ERROR, response.Code());
+    EXPECT_EQ(kExpectedCompanyPersonaLockedError, response.Message());
+  };
+  expect_locked(agent->setHardwareConcurrencyOverride(32));
+  expect_locked(agent->setNavigatorOverrides("AnotherPlatform"));
+  expect_locked(agent->setUserAgentOverride(
+      "Another/2.0", String("fr-FR"), String("AnotherPlatform"), nullptr));
+  expect_locked(agent->setLocaleOverride(String("en-US")));
+  expect_locked(agent->setTimezoneOverride("Europe/London"));
+  expect_locked(agent->resetPageScaleFactor());
+  expect_locked(agent->setPageScaleFactor(2.0));
+  expect_locked(agent->setTouchEmulationEnabled(true, 5));
+
+  auto media_features =
+      std::make_unique<protocol::Array<protocol::Emulation::MediaFeature>>();
+  media_features->push_back(protocol::Emulation::MediaFeature::create()
+                                .setName("device-width")
+                                .setValue("320px")
+                                .build());
+  expect_locked(
+      agent->setEmulatedMedia(String("screen"), std::move(media_features)));
+  expect_locked(agent->setDeviceMetricsOverride(
+      /*width=*/800, /*height=*/600, /*device_scale_factor=*/2.0,
+      /*mobile=*/true, std::nullopt, std::nullopt, std::nullopt, std::nullopt,
+      std::nullopt, std::nullopt, nullptr, nullptr, nullptr, nullptr,
+      std::nullopt, std::nullopt));
+  expect_locked(agent->clearDeviceMetricsOverride());
+  expect_locked(agent->setSmallViewportHeightDifferenceOverride(100));
+
+  unsigned int hardware_concurrency = 12;
+  String user_agent("Native/151");
+  String accept_language("zh-CN,zh");
+  std::optional<blink::UserAgentMetadata> metadata;
+  agent->ApplyHardwareConcurrencyOverride(hardware_concurrency);
+  agent->ApplyUserAgentOverride(&user_agent);
+  agent->ApplyAcceptLanguageOverride(&accept_language);
+  agent->ApplyUserAgentMetadataOverride(&metadata);
+  EXPECT_EQ(12u, hardware_concurrency);
+  EXPECT_EQ("Native/151", user_agent);
+  EXPECT_EQ("zh-CN,zh", accept_language);
+  EXPECT_FALSE(metadata);
+
+  agent->Restore();
+  hardware_concurrency = 12;
+  user_agent = "Native/151";
+  accept_language = "zh-CN,zh";
+  agent->ApplyHardwareConcurrencyOverride(hardware_concurrency);
+  agent->ApplyUserAgentOverride(&user_agent);
+  agent->ApplyAcceptLanguageOverride(&accept_language);
+  EXPECT_EQ(12u, hardware_concurrency);
+  EXPECT_EQ("Native/151", user_agent);
+  EXPECT_EQ("zh-CN,zh", accept_language);
+
+  agent->Dispose();
+  helper.Reset();
+}
