+constexpr DWORD kTestReparseTag = 0x00000042;
+constexpr GUID kTestReparseGuid = {
+    0x9a9de3e1,
+    0xc89d,
+    0x46c7,
+    {0xa7, 0x6c, 0x12, 0x87, 0xd8, 0xaa, 0x85, 0xa1}};
+
+DWORD SetTestReparsePoint(const base::FilePath& path) {
+  base::win::ScopedHandle file(::CreateFileW(
+      path.value().c_str(), GENERIC_WRITE, 0, nullptr, OPEN_EXISTING,
+      FILE_ATTRIBUTE_NORMAL | FILE_FLAG_OPEN_REPARSE_POINT, nullptr));
+  if (!file.is_valid()) {
+    return ::GetLastError();
+  }
+
+  REPARSE_GUID_DATA_BUFFER data = {};
+  data.ReparseTag = kTestReparseTag;
+  data.ReparseDataLength = 1;
+  data.ReparseGuid = kTestReparseGuid;
+  data.GenericReparseBuffer.DataBuffer[0] = 0x42;
+  DWORD bytes_returned = 0;
+  if (!::DeviceIoControl(file.get(), FSCTL_SET_REPARSE_POINT, &data,
+                         REPARSE_GUID_DATA_BUFFER_HEADER_SIZE + 1, nullptr, 0,
+                         &bytes_returned, nullptr)) {
+    return ::GetLastError();
+  }
+  return ERROR_SUCCESS;
+}
