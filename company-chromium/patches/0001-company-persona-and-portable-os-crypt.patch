+std::string ProtectPortableKey(base::span<const uint8_t> key) {
+  std::string entropy(kCompanyPortableOSCryptEntropyDomain);
+  entropy.push_back('\0');
+  entropy.append(kEnvironmentId);
+  entropy.push_back('\0');
+  entropy.append(kKeyId);
+  DATA_BLOB input = {
+      .cbData = static_cast<DWORD>(key.size()),
+      .pbData = const_cast<BYTE*>(key.data()),
+  };
+  DATA_BLOB optional_entropy = {
+      .cbData = static_cast<DWORD>(entropy.size()),
+      .pbData = reinterpret_cast<BYTE*>(entropy.data()),
+  };
+  DATA_BLOB output = {};
+  const BOOL protected_key = ::CryptProtectData(
+      &input, L"CompanyBrowser portable OSCrypt test key", &optional_entropy,
+      nullptr, nullptr, CRYPTPROTECT_UI_FORBIDDEN, &output);
+  auto output_owner = base::win::TakeLocalAlloc(output.pbData);
+  if (!protected_key || output_owner.get() == nullptr) {
+    if (output_owner.get() != nullptr && output.cbData != 0) {
+      ::SecureZeroMemory(output_owner.get(), output.cbData);
+    }
+    return std::string();
+  }
+  const std::string base64 = base::Base64Encode(
+      UNSAFE_TODO(base::span(output_owner.get(), output.cbData)));
+  if (output.cbData != 0) {
+    ::SecureZeroMemory(output_owner.get(), output.cbData);
+  }
+  return base64;
+}
